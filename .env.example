OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""
GOOGLE_API_KEY=""
# Replicate backend for AdCraft image generation (adcraft-image route)
REPLICATE_API_TOKEN=""

DEEPSEEK_BASE_URL_ANTHROPIC="https://api.deepseek.com/anthropic"
DEEPSEEK_BASE_URL_OPENAI="https://api.deepseek.com"

# Custom providers — one var per provider, referenced by name in WebUI/CLI
# MY_PROVIDER_API_KEY="sk-..."

PORT=8082
HOST=127.0.0.1

# ========================
# Video route (/v1/videos) — AdCraft video
# ========================
# When set, /v1/videos* requires "Authorization: Bearer <KEYROUTER_API_KEY>".
# Leave empty to keep the proxy unauthenticated (current behaviour).
KEYROUTER_API_KEY=""
# Modal gateway (CPU-only) that spawns GPU jobs.
#   MODAL_VIDEO_GATEWAY_URL   -> printed by `modal deploy modal/video_app.py`
#   MODAL_VIDEO_GATEWAY_TOKEN -> a secret YOU invent. Used twice, so it must be
#       the same value on both sides: key-router sends it as a Bearer header,
#       and modal/video_app.py enforces it. Set it once here, then redeploy
#       the Modal app (the value is baked into the Modal secret at deploy time).
MODAL_VIDEO_GATEWAY_URL=""
MODAL_VIDEO_GATEWAY_TOKEN=""
# MiniMax H3 (FL2VA + Ref2VA), printed by `modal deploy minimaxh3.py`.
# Uses the same MODAL_VIDEO_GATEWAY_TOKEN as the Wan gateway.
MODAL_H3_GATEWAY_URL=""

# Passed to `modal run ...::download_models` as a Modal secret at deploy time
# (higher Hugging Face rate limits). Optional — the Wan repo is public.
HF_TOKEN=""

# ========================
# Audio route (/v1/audio/video-to-sfx) — AdCraft SFX
# ========================
# Printed by `modal deploy modal/audio_app.py`.
MODAL_AUDIO_GATEWAY_URL=""
# Optional gateway auth; must match the Modal side if used.
MODAL_AUDIO_GATEWAY_TOKEN=""
# Comma-separated host:port allowlist for video_url fetching (SSRF guard).
AUDIO_VIDEO_ALLOW_HOSTS="127.0.0.1:8000,localhost:8000,127.0.0.1:8082"
